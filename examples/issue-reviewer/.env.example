# Issue reviewer agent — environment template.
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# .env is gitignored, so your key stays out of version control.

# Required: OpenAI API key. The Strands harness picks this up automatically
# when the model is "openai/...". The native web_search tool bills through
# this key, so it needs an account with billing enabled.
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: the issue to review. Keep the quotes: the values contain spaces,
# and sourcing this file would otherwise try to run the words as commands.
# You can also pass these inline on the command line instead of putting them here.
ISSUE_TITLE="Setup tool crashes with KeyError on fresh clone"
ISSUE_BODY="Running the splice setup fails with a KeyError when .splice/config.json is missing."
